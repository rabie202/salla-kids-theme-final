<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}كيدز ستايل - ملابس أطفال{% endblock %}</title>
    <meta name="description" content="متجر متخصص في ملابس الأطفال من 0 إلى 12 سنة - ألوان دافئة وأقمشة آمنة">
    
    <!-- الخطوط -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- الأنماط -->
    <link rel="stylesheet" href="{{ 'assets/css/style.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'assets/css/responsive.css' | asset_url }}">
</head>
<body class="theme-light">
    
    <!-- الشريط العلوي -->
    <div class="top-bar">
        <div class="container">
            <div class="top-bar-content">
                <div class="top-bar-text">
                    <span>🎉 شحن مجاني للطلبات فوق 200 ريال</span>
                    <span class="separator">|</span>
                    <span>🔄 إرجاع مجاني خلال 14 يوم</span>
                </div>
                <div class="top-bar-links">
                    <a href="#">العربية</a>
                    <a href="#">English</a>
                </div>
            </div>
        </div>
    </div>

    <!-- الترويسة الرئيسية -->
    <header class="main-header">
        <div class="container">
            <div class="header-content">
                <!-- الشعار -->
                <div class="logo">
                    <a href="/">
                        <span class="logo-text">كيدز ستايل</span>
                    </a>
                </div>

                <!-- البحث -->
                <div class="header-search">
                    <form action="/search" method="get">
                        <input type="text" name="q" placeholder="ابحثي عن ملابس، أحذية، إكسسوارات...">
                        <button type="submit">🔍</button>
                    </form>
                </div>

                <!-- أزرار الترويسة -->
                <div class="header-actions">
                    <a href="/account" class="header-icon" title="حسابي">
                        <span class="icon">👤</span>
                    </a>
                    <a href="/wishlist" class="header-icon" title="المفضلة">
                        <span class="icon">❤️</span>
                    </a>
                    <a href="/cart" class="header-icon" title="السلة">
                        <span class="icon">🛒</span>
                        {% if cart.item_count > 0 %}
                            <span class="badge">{{ cart.item_count }}</span>
                        {% endif %}
                    </a>
                </div>
            </div>

            <!-- قائمة التنقل -->
            <nav class="main-nav">
                <ul class="nav-list">
                    <li><a href="/">الرئيسية</a></li>
                    <li class="has-dropdown">
                        <a href="/collections/baby">رضع (0-2)</a>
                        <ul class="dropdown">
                            <li><a href="/collections/baby-girls">بنات</a></li>
                            <li><a href="/collections/baby-boys">أولاد</a></li>
                        </ul>
                    </li>
                    <li class="has-dropdown">
                        <a href="/collections/girls">بنات (2-12)</a>
                    </li>
                    <li class="has-dropdown">
                        <a href="/collections/boys">أولاد (2-12)</a>
                    </li>
                    <li><a href="/collections/accessories">إكسسوارات</a></li>
                    <li><a href="/collections/sale">العروض</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- المحتوى الرئيسي -->
    <main class="main-content">
        {% block content %}{% endblock %}
    </main>

    <!-- زر واتساب العائم -->
    {% if theme.settings.get('show_whatsapp_button') %}
        <a href="https://wa.me/966500000000" class="whatsapp-float" target="_blank" title="تواصل عبر واتساب">
            <span class="whatsapp-icon">💬</span>
        </a>
    {% endif %}

    <!-- شريط الشراء الثابت على الجوال -->
    {% if theme.settings.get('show_sticky_cart') and template == 'product' %}
        <div class="sticky-cart-bar">
            <button class="btn btn-primary btn-block">أضيفي للسلة</button>
        </div>
    {% endif %}

    <!-- التذييل -->
    <footer class="main-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col">
                    <h4>عن كيدز ستايل</h4>
                    <p>متجر متخصص في ملابس الأطفال من 0 إلى 12 سنة. نقدم أقمشة آمنة وتصاميم مريحة تناسب بشرة أطفالك الحساسة.</p>
                    <div class="social-links">
                        <a href="#" title="إنستغرام">📷</a>
                        <a href="#" title="تويتر">🐦</a>
                        <a href="#" title="سناب شات">👻</a>
                        <a href="#" title="تيك توك">🎵</a>
                    </div>
                </div>
                <div class="footer-col">
                    <h4>روابط سريعة</h4>
                    <ul>
                        <li><a href="/collections/baby">رضع</a></li>
                        <li><a href="/collections/girls">بنات</a></li>
                        <li><a href="/collections/boys">أولاد</a></li>
                        <li><a href="/collections/accessories">إكسسوارات</a></li>
                        <li><a href="/collections/sale">العروض</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>خدمة العملاء</h4>
                    <ul>
                        <li><a href="/shipping-policy">سياسة الشحن</a></li>
                        <li><a href="/return-policy">سياسة الإرجاع</a></li>
                        <li><a href="/privacy-policy">سياسة الخصوصية</a></li>
                        <li><a href="/terms">الشروط والأحكام</a></li>
                        <li><a href="/contact">اتصل بنا</a></li>
                    </ul>
                </div>
                <div class="footer-col">
                    <h4>تواصل معنا</h4>
                    <ul class="contact-info">
                        <li>📧 support@kids-style.store</li>
                        <li>📱 +966 50 000 0000</li>
                        <li>📍 الرياض، المملكة العربية السعودية</li>
                    </ul>
                    <h4 style="margin-top: 20px;">النشرة البريدية</h4>
                    <form class="newsletter-form">
                        <input type="email" placeholder="بريدك الإلكتروني" required>
                        <button type="submit">اشتراك</button>
                    </form>
                </div>
            </div>
            <div class="footer-bottom">
                <p>© 2026 كيدز ستايل. جميع الحقوق محفوظة.</p>
                <div class="payment-methods">
                    <span>مدى</span>
                    <span>فيزا</span>
                    <span>ماستركارد</span>
                    <span>آبل باي</span>
                    <span>تابي</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- الجافاسكربت -->
    <script src="{{ 'assets/js/main.js' | asset_url }}" defer></script>
    {% block scripts %}{% endblock %}
</body>
</html>
