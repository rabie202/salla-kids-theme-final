{% extends "layouts.master" %}
{% block title %}{{ store.name|default('كيدز ستايل') }}{% endblock %}
{% block content %}
<section class="hero-section"><div class="container hero-content"><div class="hero-text"><span class="eyebrow">KIDS STYLE</span><h1>أهلاً بكم في كيدز ستايل</h1><p>ملابس أطفال مريحة وأنيقة لجميع الأعمار من 0 إلى 12 سنة</p><div class="hero-buttons"><a href="/collections" class="btn btn-primary">تسوقي الآن</a><a href="/collections/sale" class="btn btn-secondary">اكتشفي العروض</a></div></div><div class="hero-art" aria-hidden="true"><span>🧸</span><span>👗</span><span>🧢</span></div></div></section>
<section class="features-strip"><div class="container features-strip-grid"><div class="feature-item"><span>🚚</span><div><h3>شحن سريع</h3><p>توصيل خلال 2-4 أيام</p></div></div><div class="feature-item"><span>↩️</span><div><h3>إرجاع مجاني</h3><p>خلال 14 يوم</p></div></div><div class="feature-item"><span>✓</span><div><h3>جودة مضمونة</h3><p>أقمشة مناسبة للأطفال</p></div></div><div class="feature-item"><span>💬</span><div><h3>دعم متواصل</h3><p>خدمة عملاء ودودة</p></div></div></div></section>
<section class="categories-section"><div class="container"><div class="section-header"><h2>تسوقي حسب الفئة</h2><a href="/collections">عرض الكل ←</a></div><div class="categories-grid"><a href="/collections/baby" class="category-card"><div>👶</div><h3>رضع (0-2)</h3></a><a href="/collections/girls" class="category-card"><div>👧</div><h3>بنات (2-12)</h3></a><a href="/collections/boys" class="category-card"><div>👦</div><h3>أولاد (2-12)</h3></a><a href="/collections/accessories" class="category-card"><div>🎒</div><h3>إكسسوارات</h3></a></div></div></section>
<section class="products-section"><div class="container"><div class="section-header"><h2>منتجات مميزة</h2><a href="/collections">عرض الكل ←</a></div><salla-products-slider source="latest" limit="8" autoplay block-title="منتجات مميزة"></salla-products-slider></div></section>
<section class="offer-banner"><div class="container offer-content"><span class="eyebrow">SPECIAL OFFER</span><h2>عروض الموسم الكبرى</h2><strong>خصم يصل إلى 30%</strong><p>على تشكيلة واسعة من ملابس الأطفال</p><a href="/collections/sale" class="btn btn-primary">تسوقي العروض الآن</a></div></section>
{% if theme.settings.get('show_testimonials', true) %}<section class="testimonials-section"><div class="container"><h2 class="section-title">ماذا يقول أهلنا عنا؟</h2><div class="testimonials-grid"><article><div>★★★★★</div><p>خامة ممتازة ومريحة جداً والتوصيل كان سريعاً.</p><strong>أم سارة — الرياض</strong></article><article><div>★★★★★</div><p>تشكيلة جميلة وألوان مناسبة للأطفال.</p><strong>أم محمد — جدة</strong></article><article><div>★★★★☆</div><p>خدمة العملاء متعاونة جداً وأنصح بالمتجر.</p><strong>أم فهد — الدمام</strong></article></div></div></section>{% endif %}
{% endblock %}
