{% extends "layouts.master" %}

{% block title %}شكراً لك | كيدز ستايل{% endblock %}

{% block content %}
<div class="thank-you-page">
    <div class="container">
        <div class="thank-you-content">
            <div class="thank-you-icon">🎉</div>
            <h1>شكراً لك على طلبك!</h1>
            <p class="thank-you-message">تم استلام طلبك بنجاح. سنقوم بإرسال تفاصيل الطلب إلى بريدك الإلكتروني.</p>
            
            <div class="order-details">
                <div class="order-number">
                    <span>رقم الطلب:</span>
                    <strong>{{ order.number }}</strong>
                </div>
                <div class="order-total">
                    <span>الإجمالي:</span>
                    <strong>{{ order.total | currency }}</strong>
                </div>
                <div class="order-status">
                    <span>حالة الطلب:</span>
                    <span class="status-badge">قيد المعالجة</span>
                </div>
            </div>

            <div class="order-next-steps">
                <h2>ما الخطوة التالية؟</h2>
                <ul>
                    <li>📧 ستصلك رسالة تأكيد على بريدك الإلكتروني</li>
                    <li>📦 سنبدأ بتجهيز طلبك فوراً</li>
                    <li>🚚 سيتم الشحن خلال 2-4 أيام عمل</li>
                    <li>📱 تتبع حالة طلبك من حسابك</li>
                </ul>
            </div>

            <div class="thank-you-actions">
                <a href="/account/orders" class="btn btn-primary">تتبع طلبي</a>
                <a href="/collections" class="btn btn-secondary">مواصلة التسوق</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
