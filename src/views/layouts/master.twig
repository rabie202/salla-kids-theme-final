<!DOCTYPE html>
<html lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% hook 'head:start' %}
    {% hook head %}
    {% block head_scripts %}{% endblock %}
    {% block styles %}{% endblock %}
    <link rel="stylesheet" href="{{ 'app.css' | asset }}">
    <link rel="stylesheet" href="{{ 'fonts/sallaicons.css' | cdn }}">
    <style>
        :root {
            --font-main: '{{ theme.font.name|default("DINNextLTArabic-Regular") }}';
            --color-primary: {{ theme.color.primary|default('#8B7355') }};
            --color-primary-dark: {{ theme.color.darker(0.15)|default('#735E48') }};
            --color-primary-light: {{ theme.color.lighter(0.15)|default('#A98F70') }};
            --color-primary-reverse: {{ theme.color.reverse_text|default('#FFFFFF') }};
        }
    </style>
    {% hook 'head:end' %}
</head>
<body id="app" class="theme-light">
    {% hook 'body:start' %}
    <div class="app-inner">
        <div class="top-bar">
            <div class="container">
                <div class="top-bar-content">
                    <div class="top-bar-text">
                        <span>🎉 شحن مجاني للطلبات فوق 200 ريال</span>
                        <span class="separator">|</span>
                        <span>🔄 إرجاع مجاني خلال 14 يوم</span>
                    </div>
                </div>
            </div>
        </div>

        <header class="main-header">
            <div class="container">
                <div class="header-content">
                    <div class="logo"><a href="{{ store.url }}"><span class="logo-text">{{ store.name }}</span></a></div>
                    <div class="header-search">
                        <salla-search></salla-search>
                    </div>
                    <div class="header-actions">
                        <salla-user-menu></salla-user-menu>
                        <salla-wishlist-summary></salla-wishlist-summary>
                        <salla-cart-summary></salla-cart-summary>
                    </div>
                </div>
                <nav class="main-nav">
                    <salla-menu></salla-menu>
                </nav>
            </div>
        </header>

        <main id="main-content" role="main">
            {% block content %}{% endblock %}
        </main>

        <footer class="main-footer">
            <div class="container">
                <div class="footer-grid">
                    <div class="footer-col">
                        <h4>عن {{ store.name }}</h4>
                        <p>{{ store.description }}</p>
                        <div class="social-links">
                            {% if store.social.instagram %}<a href="{{ store.social.instagram }}">Instagram</a>{% endif %}
                            {% if store.social.twitter %}<a href="{{ store.social.twitter }}">X</a>{% endif %}
                            {% if store.social.snapchat %}<a href="{{ store.social.snapchat }}">Snapchat</a>{% endif %}
                            {% if store.social.tiktok %}<a href="{{ store.social.tiktok }}">TikTok</a>{% endif %}
                        </div>
                    </div>
                    <div class="footer-col">
                        <h4>تواصل معنا</h4>
                        <ul class="contact-info">
                            {% if store.contacts.email %}<li>{{ store.contacts.email }}</li>{% endif %}
                            {% if store.contacts.mobile %}<li>{{ store.contacts.mobile }}</li>{% endif %}
                            {% if store.contacts.whatsapp %}<li>{{ store.contacts.whatsapp }}</li>{% endif %}
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>النشرة البريدية</h4>
                        <form class="newsletter-form">
                            <input type="email" placeholder="بريدك الإلكتروني" required>
                            <button type="submit">اشتراك</button>
                        </form>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>© {{ 'now'|date('Y') }} {{ store.name }}. جميع الحقوق محفوظة.</p>
                </div>
            </div>
        </footer>
    </div>

    {% hook 'body:end' %}
    <script defer src="{{ 'app.js' | asset }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
